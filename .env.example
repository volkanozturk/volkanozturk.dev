# Contentful API Keys
# Bunları Contentful dashboard'dan alacaksın:
# Settings > API Keys > Add API Key
CONTENTFUL_SPACE_ID=your_space_id_here
CONTENTFUL_ACCESS_TOKEN=your_access_token_here

# Preview modu için (opsiyonel)
CONTENTFUL_PREVIEW_ACCESS_TOKEN=your_preview_token_here

# Cloudflare Pages'de Environment Variables'a da bu değerleri ekle
